							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code is 200', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test('Response has success = true', function () {",
									"    const jsonData = pm.response.json();",
									"    pm.expect(jsonData.success).to.eql(true);",
									"});",
									"",
									"pm.test('Document data is present', function () {",
									"    const jsonData = pm.response.json();",
									"    const document = jsonData.data;",
									"    pm.expect(document).to.have.property('documentId');",
									"    pm.expect(document).to.have.property('title');",
									"    pm.expect(document).to.have.property('category');",
									"    pm.expect(document).to.have.property('viewCount');",
									"});",
									"",
									"pm.test('View count is incremented', function () {",
									"    const jsonData = pm.response.json();",
									"    pm.expect(jsonData.data.viewCount).to.be.above(0);",
									"});"
								]
							}
						}
					],
