									"pm.test('Documents are sorted by view count', function () {",
									"    const jsonData = pm.response.json();",
									"    const documents = jsonData.data.content;",
									"    ",
									"    for (let i = 0; i < documents.length - 1; i++) {",
									"        pm.expect(documents[i].viewCount).to.be.at.least(documents[i + 1].viewCount);",
									"    }",
									"});"
