{
	"info": {
		"name": "Legal Document API Tests",
		"description": "Test suite for Legal Document Management System - Exception Handling Verified",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8080"
		}
	],
	"item": [
		{
			"name": "✅ Exception Handling Tests",
			"item": [
				{
					"name": "Test ResourceNotFoundException (Expected 404)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('✅ Status code is 404 (Expected)', function () {",
									"    pm.response.to.have.status(404);",
									"});",
									"",
									"pm.test('✅ Exception handled properly', function () {",
									"    const jsonData = pm.response.json();",
									"    pm.expect(jsonData.success).to.eql(false);",
									"    pm.expect(jsonData.message).to.include('Document not found');",
									"    pm.expect(jsonData.message).to.include('99999');",
									"});",
									"",
									"console.log('✅ ResourceNotFoundException properly handled!');"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/documents/99999",
							"host": ["{{baseUrl}}"],
							"path": ["api", "documents", "99999"]
						}
					}
				},
				{
					"name": "Test Valid Document (Should work)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('✅ Valid document returns 200', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test('✅ Document data present', function () {",
									"    const jsonData = pm.response.json();",
									"    pm.expect(jsonData.success).to.eql(true);",
									"    pm.expect(jsonData.data).to.exist;",
									"});",
									"",
									"console.log('✅ Valid document access works!');"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/documents/1",
							"host": ["{{baseUrl}}"],
							"path": ["api", "documents", "1"]
						}
					}
				},
				{
					"name": "Test Search (Should work)",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('✅ Search returns 200', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test('✅ Search results format correct', function () {",
									"    const jsonData = pm.response.json();",
									"    pm.expect(jsonData.success).to.eql(true);",
									"    pm.expect(jsonData.data).to.have.property('content');",
									"});",
									"",
									"console.log('✅ Search functionality works!');"
								]
							}
						}
					],
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/api/documents/search?keyword=test&page=0&size=5",
							"host": ["{{baseUrl}}"],
							"path": ["api", "documents", "search"],
							"query": [
								{"key": "keyword", "value": "test"},
								{"key": "page", "value": "0"},
								{"key": "size", "value": "5"}
							]
						}
					}
				}
			]
		}
	]
}