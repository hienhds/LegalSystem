							"raw": "{{base_url}}/api/admin/documents?page=0&size=10&search=dân sự",
							"host": ["{{base_url}}"],
							"path": ["api", "admin", "documents"],
							"query": [
								{
									"key": "page",
									"value": "0"
								},
								{
									"key": "size",
									"value": "10"
								},
								{
									"key": "search",
									"value": "dân sự",
									"description": "Tìm kiếm theo tiêu đề"
								}
							]
						},
						"description": "Tìm kiếm văn bản theo tiêu đề"
					},
					"response": []
				},
