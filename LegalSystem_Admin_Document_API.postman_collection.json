{
	"info": {
		"_postman_id": "legal-doc-admin-api",
		"name": "LegalSystem - Admin Document Management API",
		"description": "API collection for managing legal documents in admin panel",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"auth": {
		"type": "bearer",
		"bearer": [
			{
				"key": "token",
				"value": "{{access_token}}",
				"type": "string"
			}
		]
	},
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:8080",
			"type": "string"
		},
		{
			"key": "access_token",
			"value": "",
			"type": "string"
		}
	],
	"item": [
		{
			"name": "Authentication",
			"item": [
				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"if (pm.response.code === 200) {",
									"    var jsonData = pm.response.json();",
									"    pm.collectionVariables.set(\"access_token\", jsonData.accessToken);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"auth": {
							"type": "noauth"
						},
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"admin@legalconnect.com\",\n  \"password\": \"admin123\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/auth/login",
							"host": ["{{base_url}}"],
							"path": ["api", "auth", "login"]
						},
						"description": "Login với tài khoản admin để lấy access token"
					},
					"response": []
				}
			]
		},
		{
			"name": "Document Management",
			"item": [
				{
					"name": "1. Get Stats",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/admin/documents/stats",
							"host": ["{{base_url}}"],
							"path": ["api", "admin", "documents", "stats"]
						},
						"description": "Lấy thống kê: tổng số, active, inactive"
					},
					"response": []
				},
				{
					"name": "2. Get All Documents (No Filter)",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/api/admin/documents?page=0&size=10&sort=createdAt,desc",
							"host": ["{{base_url}}"],
							"path": ["api", "admin", "documents"],
							"query": [
								{
									"key": "page",
									"value": "0",
									"description": "Số trang (bắt đầu từ 0)"
								},
								{
									"key": "size",
									"value": "10",
									"description": "Số bản ghi mỗi trang"
								},
								{
									"key": "sort",
									"value": "createdAt,desc",
									"description": "Sắp xếp: field,direction"
								}
							]
						},
						"description": "Lấy tất cả văn bản với pagination"
					},
					"response": []
				},
				{
					"name": "3. Search Documents by Title",
					"request": {
						"method": "GET",
						"header": [],
